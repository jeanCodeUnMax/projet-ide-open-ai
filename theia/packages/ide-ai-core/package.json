{
  "name": "@ide-ai/theia-core",
  "version": "0.1.0",
  "description": "IDE-AI integration services for Eclipse Theia",
  "license": "MIT",
  "private": true,
  "keywords": [
    "theia-extension",
    "ide-ai",
    "openfox"
  ],
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@theia/core": "1.73.1",
    "@theia/workspace": "1.73.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/frontend-module",
      "backend": "lib/node/backend-module"
    }
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "compile": "tsc -b && node scripts/copy-assets.mjs",
    "test": "node --test",
    "watch": "tsc -b -w --preserveWatchOutput"
  }
}
