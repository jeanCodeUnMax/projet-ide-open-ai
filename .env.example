# Optional: executable Node.js used to launch the OpenFox server.
OPENAI_IDE_NODE_BINARY=node

# Variables referenced from mcp_config.json, for example ${env:GITHUB_TOKEN}.
GITHUB_TOKEN=
BRAVE_API_KEY=

# A2A local development server.
A2A_PORT=43110

# Existing Hephaistos-kit service. Leave empty to disable the adapter.
HEPHAISTOS_BASE_URL=http://127.0.0.1:8787
HEPHAISTOS_TOKEN=
HEPHAISTOS_WORKSPACE_ID=

# Local OCR commands: Poppler (pdftotext/pdfimages), OCRmyPDF and Tesseract.
OCR_LANGUAGES=fra+eng

# Mistral embeddings. No embedding call is made without MISTRAL_API_KEY.
MISTRAL_API_KEY=
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_EMBED_URL=https://api.mistral.ai/v1/embeddings

# OpenAI-compatible multimodal chat endpoint used to describe images.
# Configure the model explicitly because vision model names change over time.
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=

# Qdrant vector store. No vector upsert is performed without QDRANT_URL and embeddings.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ide_open_ai_documents
